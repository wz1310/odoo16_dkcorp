<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_est_sale_mo" model="ir.ui.view">
        <field name="name">est.sale.mo</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button class="btn-primary" name="action_cek_est" string="Cek Estimasi" type="object"/>
                <!-- <button class="btn-primary" name="cek_last_bom" string="Cek BOM" type="object"/> -->
                <button class="btn-primary" name="create_int_bom" string="Create Int. trf BoM" type="object"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='product_uom_qty']" position="after">
                <field name="est" string="Estimasi Qty" readonly="1" force_save="True"/>
            </xpath>
        </field>
    </record>

    <!-- TAMBAHAN SERVER ACTION UNTUK LIST VIEW MULTI-RECORD / CHECKBOX -->
    <record id="action_server_create_bulk_int_bom" model="ir.actions.server">
        <field name="name">Create Bulk BoM Int. Transfer</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_create_bulk_int_bom()
        </field>
    </record>


    <!-- TAMBAHAN WIZARD VIEW FORM POPUP -->
    <record id="view_sale_order_percentage_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.percentage.wizard.form</field>
        <field name="model">sale.order.percentage.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Qty by Percentage">
                <group>
                    <field name="percentage"/>
                </group>
                <footer>
                    <button string="Validate" name="action_validate_percentage" type="object" class="btn-primary" confirm="Apakah Anda yakin?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- TAMBAHAN SERVER ACTION UNTUK MEMUNCULKAN POPUP WIZARD DARI LIST VIEW -->
    <record id="action_server_update_qty_percentage" model="ir.actions.server">
        <field name="name">Update Qty by Percentage (%)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = {
                'name': 'Update Qty by Percentage',
                'type': 'ir.actions.act_window',
                'res_model': 'sale.order.percentage.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': env.context,
            }
        </field>
    </record>

</odoo>