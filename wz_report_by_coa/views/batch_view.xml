<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================== -->
        <!-- 1. VIEWS FOR BATCH MASTER                  -->
        <!-- ========================================== -->

        <!-- Tree / List View Master Batch -->
        <record id="view_sale_order_batch_tree" model="ir.ui.view">
            <field name="name">sale.order.batch.tree</field>
            <field name="model">sale.order.batch</field>
            <field name="arch" type="xml">
                <tree string="Batch Master">
                    
                    <field name="name"/>
                    <field name="sale_order_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- Form View Master Batch -->
        <record id="view_sale_order_batch_form" model="ir.ui.view">
            <field name="name">sale.order.batch.form</field>
            <field name="model">sale.order.batch</field>
            <field name="arch" type="xml">
                <form string="Batch Master">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                        <group>
                            <group>
                                <field name="name"/>
                                
                            </group>
                            <group>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="sale_order_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View Master Batch -->
        <record id="view_sale_order_batch_search" model="ir.ui.view">
            <field name="name">sale.order.batch.search</field>
            <field name="model">sale.order.batch</field>
            <field name="arch" type="xml">
                <search string="Cari Batch">
                    <field name="name"/>
                    
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- ========================================== -->
        <!-- 2. ACTION FOR BATCH MASTER                 -->
        <!-- ========================================== -->

        <record id="action_sale_order_batch" model="ir.actions.act_window">
            <field name="name">Batch Master</field>
            <field name="res_model">sale.order.batch</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_sale_order_batch_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Buat Batch Master Pertama Anda!
                </p>
                <p>
                    Master Batch digunakan untuk mengelompokkan Sales Order.
                </p>
            </field>
        </record>

        <!-- ========================================== -->
        <!-- 3. MENUITEM UNDER SALES CONFIGURATION      -->
        <!-- ========================================== -->

        <menuitem id="menu_sale_order_batch"
                  name="Batch Master"
                  action="action_sale_order_batch"
                  parent="sale.menu_sale_config"
                  sequence="10"/>

    </data>
</odoo>