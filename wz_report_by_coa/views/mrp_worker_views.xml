<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Form View MRP Production -->
    <record id="mrp_production_form_view_inherit_worker" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.worker</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <!-- <field name="sale_order_id" options="{'no_create': True}" domain="[('state', 'in', ['sale', 'done'])]" attrs="{'readonly': [('state', '=', 'done')]}"/> -->
                <field name="batch_id" attrs="{'readonly': [('state', '=', 'done')]}" options="{'no_create': True}"/>
                <field name="sale_order_ids" widget="many2many_tags" options="{'no_create': True}" domain="[('state', 'in', ['sale', 'done'])]"/>
                <field name="max_worker_qty" readonly="1"/>
            </xpath>

            <!-- Pastikan field cek_leader dipanggil dulu di view agar nilainya bisa dibaca XML -->
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="cek_leader" invisible="0"/>
                <field name="cek_user_mo" invisible="0"/>
            </xpath>

            <!-- Menambahkan kondisi attrs invisible pada group pertama -->
            <xpath expr="//sheet/group/group[1]" position="attributes">
                <attribute name="attrs">{'invisible': [('cek_user_mo', '=', True),('cek_leader', '=', False)]}</attribute>
            </xpath>

            <!-- 1. Sembunyikan page 'Components' jika cek_leader = True -->
            <xpath expr="//page[@name='components']" position="attributes">
                <attribute name="attrs">{'invisible': [('cek_leader', '=',True),('cek_user_mo', '=',False)]}</attribute>
            </xpath>

            <!-- 2. Sembunyikan page 'Miscellaneous' jika cek_leader = True -->
            <xpath expr="//page[@name='miscellaneous']" position="attributes">
                <attribute name="attrs">{'invisible': [('cek_leader', '=',True),('cek_user_mo', '=',False)]}</attribute>
            </xpath>

            <!-- 3. Sembunyikan page 'approval_matrix' jika cek_leader = True -->
            <xpath expr="//page[@name='approval_matrix']" position="attributes">
                <attribute name="attrs">{'invisible': [('cek_leader', '=',True),('cek_user_mo', '=',False)]}</attribute>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Daftar Pekerja" name="worker_tab" attrs="{'invisible': [('cek_leader', '=', True)]}">
                    <field name="worker_line_ids" attrs="{'readonly': [('state', '=', 'done')]}">
                        <tree editable="bottom">
                            <field name="worker_id"/>
                            <field name="wage"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- View Tree Master Pekerja -->
    <record id="view_mrp_worker_tree" model="ir.ui.view">
        <field name="name">mrp.worker.tree</field>
        <field name="model">mrp.worker</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="user_id"/>
                <field name="wage"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <!-- Action Master Pekerja -->
    <record id="action_mrp_worker" model="ir.actions.act_window">
        <field name="name">Master Pekerja</field>
        <field name="res_model">mrp.worker</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- View Tree Master Formula -->
    <record id="view_mrp_worker_formula_tree" model="ir.ui.view">
        <field name="name">mrp.worker.formula.tree</field>
        <field name="model">mrp.worker.formula</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="qty_base"/>
                <field name="worker_count"/>
            </tree>
        </field>
    </record>

    <!-- Action Master Formula -->
    <record id="action_mrp_worker_formula" model="ir.actions.act_window">
        <field name="name">Formula Pekerja SO</field>
        <field name="res_model">mrp.worker.formula</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- Menuitem under Configuration Manufacturing -->
    <menuitem id="menu_mrp_worker_config"
              name="Master Pekerja"
              parent="mrp.menu_mrp_configuration"
              action="action_mrp_worker"
              sequence="50"/>

    <menuitem id="menu_mrp_worker_formula_config"
              name="Setting Formula SO Pekerja"
              parent="mrp.menu_mrp_configuration"
              action="action_mrp_worker_formula"
              sequence="51"/>

    <record id="view_mrpproduct_inherit" model="ir.ui.view">
        <field name="name">mrp.product.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='detailed_type']" position="after">
                <field name="worker"/>
                <label for="engine_load" string="Engine Load"/>
                    <div class="o_row" style="max-width: 300px;">
                        <field name="engine_load" placeholder="Load" class="oe_inline"/>
                        <field name="engine_percent" placeholder="Percent" class="oe_inline"/>
                        <span>%</span>
                    </div>
            </xpath>
        </field>
    </record>


     <record id="group_mo_leader" model="res.groups">
        <field name="name">MO Leader</field>
    </record>
    <record id="group_mo_user" model="res.groups">
        <field name="name">MO User</field>
    </record>
</odoo>