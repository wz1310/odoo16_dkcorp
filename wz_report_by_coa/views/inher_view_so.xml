<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Form View Sales Order -->
        <record id="view_order_form_inherit_worker" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.worker</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Daftar Pekerja" name="page_workers">
                        <field name="worker_line_ids">
                            <tree editable="bottom">
                                <field name="worker_id"/>
                            </tree>
                            <form>
                                <group>
                                    <field name="worker_id"/>
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>

                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="batch_id"/>
                </xpath>
            </field>
        </record>

        <!-- ========================================== -->
        <!-- FORM VIEW & ACTION UNTUK POPUP WIZARD     -->
        <!-- ========================================== -->

        <record id="view_sale_order_assign_worker_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.assign.worker.wizard.form</field>
        <field name="model">sale.order.assign.worker.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Daftar Pekerja &amp; Batch">
                <sheet>
                    <group>
                        <field name="batch_id" options="{'no_create_edit': False}"/>
                        <field name="max_worker_qty" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Daftar Pekerja">
                            <field name="worker_line_ids">
                                <tree editable="bottom">
                                    <field name="worker_id" options="{'no_create': True}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Konfirmasi" name="action_apply" type="object" class="btn-primary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
        </record>

        <!-- Action Window untuk Membuka Popup Wizard -->
        <record id="action_sale_order_assign_worker_wizard" model="ir.actions.act_window">
            <field name="name">Set Daftar Pekerja &amp; Batch</field>
            <field name="res_model">sale.order.assign.worker.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_view_types">list</field>
        </record>

    </data>
</odoo>