<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coa_form_inherit" model="ir.ui.view">
        <field name="name">coa.form.inherit</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allowed_journal_ids']" position="after">
            	<field name="ycogs"/>
            	<field name="ypnl"/>
            	<field name="ybs"/>
            	<field name="mcogs"/>
            	<field name="mpnl"/>
            	<field name="mbs"/>
            </xpath>
            <xpath expr="//page[@name='accounting']/group/group[2]" position="inside">
            	<field name="cogsvslmly"/>
            	<field name="pnlvslmly"/>
            	<field name="bslvslmly"/>
            	<field name="cogsytd"/>
            	<field name="pnlytd"/>
            	<field name="bsytd"/>
            </xpath>
        </field>
    </record>
    
</odoo>