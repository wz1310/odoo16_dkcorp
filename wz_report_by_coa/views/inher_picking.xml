<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_inherit" model="ir.ui.view">
        <field name="name">stock.picking.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='backorder_id']" position="after">
                <field name="user_so" invisible="True"/>
                <field name="real_driver" invisible="True"/>
                <field name="driver"/>
                <!-- <field name="driver" attrs="{'readonly': [('user_so', '=', False)]}"/> -->
            </xpath>
        </field>
    </record>


    <record id="view_picking_form_inherit_ribbon" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.ribbon</field>
        <field name="model">stock.picking</field>
        <!-- Masukkan ID view dari module asal yang ingin di-inherit -->
        <field name="inherit_id" ref="wz_multi_upload_img.wz_inher_picking"/> 
        <field name="arch" type="xml">
            
            <!-- Mengubah atribut 'attrs' pada widget web_ribbon yang sudah ada -->
            <xpath expr="//button[@name='receive_do']" position="attributes">
                <attribute name="attrs">{'invisible': ['|','|', ('delivery_state', 'in', ['received']),('state', 'not in', ['done']),('user_so', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//page[@name='image_upload']" position="attributes">
                <attribute name="attrs">{'invisible': [('real_driver', '=', False)]}</attribute>
            </xpath>

        </field>
    </record>


     
    <!-- <record id="group_driver" model="res.groups">
        <field name="name">Driver</field>
    </record> -->
     <record id="group_driver" model="res.groups">
        <field name="name">Driver</field>
    </record>
    
</odoo>