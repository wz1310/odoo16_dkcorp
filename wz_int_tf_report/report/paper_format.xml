<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--paper format for parking ticket-->
    <record id="paperformat_internal_report" model="report.paperformat">
        <field name="name">Internal Report</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">140</field>
        <field name="page_width">210</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0.5</field>
        <field name="margin_bottom">0.5</field>
        <field name="margin_left">0.5</field>
        <field name="margin_right">0.5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
</odoo>