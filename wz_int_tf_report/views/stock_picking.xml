<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="internal_stock_picking_form_button" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_print_internal_picking_report" string="Print Internal Report" type="object" attrs="{'invisible': [('picking_type_code', '!=', 'internal')]}"/>
            </xpath>
    </field>
    </record>
    
        <report
            id="action_report_delivery_internal_xlsx"
            model="stock.picking"
            string="Internal Transfer (Excel)"
            report_type="xlsx"
            name="wz_int_tf_report.report_delivery_internal_xlsx"
            file="Internal_Transfer"
            attachment_use="False"/>
</odoo>