<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_inherits_form" model="ir.ui.view">
        <field name="name">sale.forms</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <!-- <field name="send_by" readonly="1" force_save="True"/> -->
                <field name="send_by"/>
            </xpath>
        </field>
    </record>


    <record id="view_pick_inherits_form" model="ir.ui.view">
        <field name="name">pick.forms</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='backorder_id']" position="after">
                <field name="driver_pengganti"/>
                <!-- <field name="send_by_so" readonly="1" force_save="True"/> -->
                <field name="send_by_so"/>
            </xpath>
        </field>
    </record>


    <record id="action_urgent_delivery" model="ir.actions.act_window">
    <field name="name">Urgent Delivery</field>
    <field name="res_model">urgent.delivery</field>
    <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_urgent_delivery"
          name="Urgent Delivery"
          parent="sale.sale_order_menu"
          action="action_urgent_delivery"
          sequence="20"/>


</odoo>