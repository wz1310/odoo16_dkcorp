<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_inherits_form" model="ir.ui.view">
        <field name="name">sale.forms</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <!-- <field name="send_by" readonly="1" force_save="True"/> -->
                <field name="send_by"/>
            </xpath>
        </field>
    </record>

    <record id="view_pick_inherits_form" model="ir.ui.view">
        <field name="name">pick.forms</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_transfer_driver_wizard" 
                        string="TRANSFER DRIVER" 
                        type="object" 
                        class="oe_highlight"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="date_approved_by_other_driver" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='backorder_id']" position="after">
                <field name="driver_pengganti" readonly="1"/>
                <!-- <field name="send_by_so" readonly="1" force_save="True"/> -->
                <field name="send_by_so"/>
            </xpath>
        </field>
    </record>

    <!-- Form View Wizard Transfer Driver (Popup) -->
    <record id="view_transfer_driver_wizard_form" model="ir.ui.view">
        <field name="name">transfer.driver.wizard.form</field>
        <field name="model">transfer.driver.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Driver">
                <sheet>
                    <group>
                        <field name="picking_id" invisible="1"/>
                        <field name="driver_pengganti_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_transfer" string="Validasi" type="object" class="btn-primary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Custom Form View untuk Urgent Delivery dengan tombol Validate, Cancel, dan Set to Draft -->
    <record id="view_urgent_delivery_form" model="ir.ui.view">
        <field name="name">urgent.delivery.form</field>
        <field name="model">urgent.delivery</field>
        <field name="arch" type="xml">
            <form string="Urgent Delivery">
                <header>
                    <button name="action_validate" string="Validate" type="object" class="oe_highlight" states="draft"/>
                    <button name="action_cancel" string="Cancel" type="object" states="draft,validate"/>
                    <button name="action_set_to_draft" string="Set to Draft" type="object" states="cancel"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validate"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="diajukan_oleh"/>
                            <field name="sale_order_id"/>
                        </group>
                        <group>
                            <field name="send_by"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_urgent_delivery" model="ir.actions.act_window">
        <field name="name">Urgent Delivery</field>
        <field name="res_model">urgent.delivery</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_urgent_delivery"
          name="Urgent Delivery"
          parent="sale.sale_order_menu"
          action="action_urgent_delivery"
          sequence="20"/>
</odoo>